{
  "name": "dsh-stock-research",
  "version": "0.3.0",
  "description": "股票投资尽调工作台：7 个尽调方法技能 + 每只股票一个独立档案（清单/历史报告/估值快照，互不覆盖）+ stock_checklist & stock_archive 工具。侧栏「投资尽调」研究所页面（概览/尽调列表/报告阅读/发起新尽调）。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "lib",
    "lab",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "stock",
    "research",
    "investment"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/lib.test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
